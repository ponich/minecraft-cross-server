# =======================================================
# Minecraft NeoForge Server - Git Ignore Configuration
# =======================================================
# This file excludes auto-generated content from Git tracking
#
# What gets ignored:
# • mods/ - Large binary JAR files (32 mods, ~300MB)
# • config/ - Auto-generated mod configurations 
# • world/ - Server world data (can be large)
# • logs/ - Runtime logs and crash reports
# • temp files - Backups, locks, temporary data
#
# Why: These files are either too large, change frequently,
# or are automatically regenerated by the server.
# =======================================================

# Minecraft Server Files
# Do not track mods - they are large binary files
mods/
*.jar

# Server runtime data
world/
logs/
crash-reports/
debug/

# Auto-generated mod configurations
config/
!config/.gitkeep

# Server state files
server.properties.backup
eula.txt.backup
banned-ips.json
banned-players.json
ops.json
whitelist.json
usercache.json
usernamecache.json

# Temporary files
*.tmp
*.temp
*.log
*.lock
*.pid

# Config backups
config/*.backup
config/*.bak

# Docker volumes and data
minecraft-data/

# IDE and OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
.docker/
build/
dist/
target/

# Environment files
.env
.env.local
.env.production

# Runtime logs
nohup.out
server.log
latest.log 